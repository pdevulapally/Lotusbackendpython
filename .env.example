# Export values, or explicitly pass this file with uv --env-file.
# Never commit a populated copy. Blank fields require real deployment values.
API_ENVIRONMENT=development
API_DOCS_ENABLED=false
# Explicit transport policy. Keep true for a public HTTPS API behind Caddy.
# Set false only for an intentionally configured private/local HTTP environment.
REQUIRE_HTTPS=true
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_TIMEOUT_SECONDS=5
# Actual Firestore database ID; specify (default) explicitly if that is your database.
FIRESTORE_DATABASE_ID=
FIRESTORE_TIMEOUT_SECONDS=5
# Required authorization collection names as a JSON object with all six keys:
# resources, teams, members, grants, links, policies. No collection names are assumed.
AUTHORIZATION_COLLECTIONS=
AUTHORIZATION_POLICY_ID=
AUTHORIZATION_LINK_TOKEN_BYTES=32
AUTHORIZATION_MAX_PARENT_DEPTH=10
# Maximum explicit resource IDs checked in one batch. Choose for your workload.
AUTHORIZATION_MAX_BATCH_RESOURCES=
# Match the project kind and action names in your trusted Firestore policy.
PROJECT_RESOURCE_KIND=
PROJECT_CREATE_PERMISSION=
PROJECT_READ_PERMISSION=
PROJECT_NAME_MAX_BYTES=
PROJECT_SESSIONS_COLLECTION=
# A project update permission from the trusted authorization policy.
PROJECT_SESSION_WRITE_PERMISSION=
SESSION_QUESTION_MAX_BYTES=
# An explicit update action on the project for submitting agent work.
PROJECT_RUN_PERMISSION=
AI_RUNS_COLLECTION=
AI_RUN_TIMEOUT_SECONDS=
AI_ANSWER_MAX_BYTES=

# Dispatcher process only. Supply the real private snapshot and separate paths.
WORKER_DAYTONA_API_KEY=
WORKER_DAYTONA_API_URL=
WORKER_DAYTONA_TARGET=
WORKER_SNAPSHOT=
WORKER_NAMESPACE=
WORKER_WORKSPACE=
WORKER_STATE_DIR=
WORKER_SCRIPT=/opt/lotusbuild/sandbox_worker.py
WORKER_ANTHROPIC_API_KEY=
WORKER_POLL_SECONDS=
WORKER_OPERATION_SECONDS=
WORKER_LEASE_SECONDS=
WORKER_IDLE_MINUTES=5
WORKER_MAX_STEPS=
WORKER_FILE_MAX_BYTES=
WORKER_CONTEXT_MAX_BYTES=
# Plan keys, model IDs, per-user request limits, and Stripe Price mapping are deployment policy.
# Each MODEL_PLANS entry needs scope (individual/team), model_id, max_output_tokens,
# and request_limit with requests and window_seconds.
MODEL_PLANS=
FREE_PLAN_ID=
STRIPE_PRICE_PLANS=
BILLING_COLLECTION=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=
STRIPE_SIGNATURE_TOLERANCE_SECONDS=
STRIPE_TIMEOUT_SECONDS=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Supply your self-hosted Redis URL. Use rediss:// for TLS.
RATE_LIMIT_REDIS_URL=
# Use one prefix shared by every worker in this deployment; isolate environments.
RATE_LIMIT_KEY_PREFIX=
RATE_LIMIT_TIMEOUT_SECONDS=5
RATE_LIMIT_POLICIES={"default":{"requests":60,"window_seconds":60}}
RATE_LIMIT_DEFAULT_POLICY=default
PRE_AUTH_RATE_LIMIT={"requests":300,"window_seconds":60}
REQUEST_MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30
# Leave time for the API's own timeout response to reach Caddy.
CADDY_UPSTREAM_TIMEOUT_SECONDS=35

# JSON arrays of exact origins and hostnames. No wildcard origins/hosts.
# Origins must use HTTPS when REQUIRE_HTTPS is true.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOWED_HEADERS=["Authorization","Content-Type"]
CORS_EXPOSE_HEADERS=["X-Request-ID","Retry-After"]
CORS_MAX_AGE_SECONDS=600
ALLOWED_HOSTS=
LOG_LEVEL=INFO

# Required by serve.py. Set for your actual Caddy/network/resource arrangement.
SERVER_HOST=
SERVER_PORT=
SERVER_WORKERS=
SERVER_LIMIT_CONCURRENCY=
SERVER_KEEP_ALIVE_SECONDS=
SERVER_GRACEFUL_SHUTDOWN_SECONDS=
# JSON array of only the actual Caddy peer IPs/CIDRs. Never use * or /0.
SERVER_TRUSTED_PROXY_IPS=

# Used only by deploy/Caddyfile, supplied to the Caddy process separately.
API_DOMAIN=
API_UPSTREAM=

# Required only by the explicit scripts.check_services command.
# Choose the intended test environment explicitly; it must match API_ENVIRONMENT.
INTEGRATION_TARGET_ENVIRONMENT=
INTEGRATION_API_ORIGIN=
# Simulated peer IP for the in-process smoke check, not the public server address.
INTEGRATION_CLIENT_IP=
INTEGRATION_ID_TOKEN=
INTEGRATION_EXPECTED_UID=
